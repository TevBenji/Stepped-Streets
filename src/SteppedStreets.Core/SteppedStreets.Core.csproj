<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\build\GameReferences.props" />
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Version>2.7.0</Version>
    <Nullable>disable</Nullable>
    <RootNamespace>SteppedStreets.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The generator's survey and street stages are internal; the off-game tests check them directly. -->
    <InternalsVisibleTo Include="SteppedStreets.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Unity.Mathematics">
      <HintPath>$(ManagedPath)\Unity.Mathematics.dll</HintPath>
      <Private>false</Private>
      <!-- Keep UnityEngine dependencies out of the planner's compiler references. -->
      <ExternallyResolved>true</ExternallyResolved>
    </Reference>
  </ItemGroup>
</Project>
